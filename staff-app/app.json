{
  "expo": {
    "name": "باي رسلان — الموظفين",
    "slug": "byraslan-staff",
    "scheme": "byraslanstaff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.byraslan.staff",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ar",
        "NSCameraUsageDescription": "عشان تصوّر سيلفي وانت بتسجّل حضورك",
        "NSLocationWhenInUseUsageDescription": "عشان نتأكد إنك في مكان الشغل وانت بتسجّل حضورك"
      }
    },
    "android": {
      "package": "com.byraslan.staff",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "عشان نتأكد إنك في مكان الشغل وانت بتسجّل حضورك"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "عشان تصوّر سيلفي وانت بتسجّل حضورك"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5C800"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "supabaseUrl": "https://univnbcayoizvtfwfugn.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVuaXZuYmNheW9penZ0ZndmdWduIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM4MTQ2NDIsImV4cCI6MjEwOTM5MDY0Mn0.AKWnentjb2uSq94BPFnhu6XaJ96GnsjoobfrhO7vZ_o",
