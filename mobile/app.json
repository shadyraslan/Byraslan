{
  "expo": {
    "name": "باي رسلان",
    "slug": "byraslan",
    "scheme": "byraslan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.byraslan.app",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false, "CFBundleDevelopmentRegion": "ar" }
    },
    "android": {
      "package": "com.byraslan.app",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#000000" },
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 220, "backgroundColor": "#000000" }],
      ["expo-notifications", { "color": "#F5C800" }]
    ],
    "experiments": { "typedRoutes": false },
